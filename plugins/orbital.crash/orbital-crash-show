#!/bin/bash

# Click target of the crash toast: opens the orbital.crash modal with the
# payload built by orbital-crash-watch. If the modal does not come up (shell
# running an older cached copy of the plugin, plugin disabled), falls back to
# the stock behaviour of the toast and starts the AI diagnosis directly, so a
# click never does nothing.
#
# Usage: orbital-crash-show <payload-json>

set -uo pipefail

readonly PLUGIN_ID=orbital.crash
payload=${1:?usage: orbital-crash-show <payload-json>}

out=$(omarchy-shell shell summon "$PLUGIN_ID" "$payload" 2>&1)
if [[ $out == *ok* ]]; then
  # summon says "ok" even when the plugin failed to load; confirm it opened.
  for _ in $(seq 1 15); do
    [[ $(omarchy-shell shell call "$PLUGIN_ID" status "" 2>&1) == *open* ]] && exit 0
    sleep 0.1
  done
fi

IFS=$'\t' read -r pid comm exe signal < <(
  jq -r '[.pid, .comm, .exe, .signal] | map(. // "unknown") | @tsv' <<<"$payload"
)
exec "${ORBITAL_CRASH_FALLBACK:-omarchy-agent-crash}" "$pid" "$comm" "$exe" "$signal"
