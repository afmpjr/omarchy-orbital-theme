#!/usr/bin/env bash
# orbital-avatar - set the avatar shown in the dock and the account card.
#   orbital-avatar <image>     use this image (cropped to a 256x256 square when ImageMagick is present)
#   orbital-avatar --github    use your GitHub profile picture (needs `gh auth login`)
#   orbital-avatar --reset     remove it (the Omarchy icon is shown again)
# The file is ~/.config/omarchy/avatar.png, the same one the lock screen plugins read.
set -euo pipefail
DEST="$HOME/.config/omarchy/avatar.png"
mkdir -p "$(dirname "$DEST")"
fit() { if command -v magick >/dev/null; then magick "$1" -resize 256x256^ -gravity center -extent 256x256 "$DEST"; else cp "$1" "$DEST"; fi; }
case "${1:-}" in
  ""|-h|--help) sed -n 2,7p "$0"; exit 0 ;;
  --reset) rm -f "$DEST"; echo "Avatar removed." ;;
  --github)
    url="$(gh api user -q .avatar_url)"; tmp="$(mktemp)"; curl -fsSL "$url" -o "$tmp"; fit "$tmp"; rm -f "$tmp"; echo "Avatar set from GitHub." ;;
  *) [[ -f $1 ]] || { echo "No such file: $1" >&2; exit 1; }; fit "$1"; echo "Avatar set from $1." ;;
esac
# The dock loads the picture once; restart the shell to pick the change up.
[[ ${2:-} == --no-restart || ${ORBITAL_NO_RESTART:-} == 1 ]] || omarchy restart shell >/dev/null 2>&1 || true
